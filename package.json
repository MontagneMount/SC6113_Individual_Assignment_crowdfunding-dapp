{
  "name": "crowdfunding-dapp",
  "version": "0.1.0",
  "description": "Campus crowdfunding DApp for SC6113: Solidity smart contract, MetaMask, Node.js + Express backend, MongoDB",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "compile": "hardhat compile && node scripts/export-abi.js",
    "test": "hardhat test",
    "test:server": "node --test server/test/*.test.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "hardhat": "^3.18.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "mongodb": "^7.7.0",
    "multer": "^2.4.0"
  }
}
