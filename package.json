{
  "name": "crowdfunding-dapp",
  "version": "0.1.0",
  "description": "Smart-contract tooling for CampusFund (SC6113): compiles and tests the Solidity contract with Hardhat. The web backend is Python Flask (see requirements.txt).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "compile": "hardhat compile && node scripts/export-abi.js",
    "test": "hardhat test",
    "vendor:ethers": "node scripts/vendor-ethers.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "hardhat": "^3.18.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "ethers": "^6.17.0"
  }
}
