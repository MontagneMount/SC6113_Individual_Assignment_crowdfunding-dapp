# Copy this file to `.env` and fill in real values. Never commit `.env`.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers > Python)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=crowdfunding

# Sepolia JSON-RPC endpoint the backend uses to read the blockchain (this public one needs no key)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: endpoint for event logs older than the main RPC keeps (about two days)
# SEPOLIA_HISTORY_RPC_URL=https://sepolia.gateway.tenderly.co

# Optional: wallets (comma-separated) that may open the visitor log at /admin.
# Without it, the wallet that deployed the contract is the admin.
# ADMIN_ADDRESSES=0x...

# Port for the local web server
PORT=3000
